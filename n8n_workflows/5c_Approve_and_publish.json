    {
      "parameters": {
        "promptType": "define",
        "text": "=Run {{ $('Prepare approval').first().json.run_id }} has been APPROVED by a human reviewer.\nPublish it now:\n1. Call the tool append_to_doc with run_id = {{ $('Prepare approval').first().json.run_id }}\n2. Call the tool create_email_draft with the same run_id.\nCall each tool exactly once. Then reply with one short line per tool, quoting what the tool returned.",
        "options": {
