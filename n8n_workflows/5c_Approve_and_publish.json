    {
      "parameters": {
        "jsCode": "// ---- Pick the draft to approve and build the approval email (plain text) ----\nconst runs = $('Read runs').all(0, 0).map(i => i.json);\nconst cfg = Object.fromEntries($('Read config').all(0, 0).map(i => [i.json.key, String(i.json.value ?? '')]));\nlet runId = '';\ntry { runId = String($('When called by orchestrator').first().json.run_id || ''); } catch (e) {}\nconst run = runId ? runs.find(r => r.run_id === runId)\n  : runs.filter(r => r.status === 'draft_ready').sort((a, b) => String(b.updated_at).localeCompare(String(a.updated_at)))[0];\nif (!run) throw new Error(runId ? `Run ${runId} not found` : 'No run with status draft_ready. Run the Draft workflow first.');\nif (run.status !== 'draft_ready') throw new Error(`Run ${run.run_id} is \"${run.status}\" – only draft_ready runs can be sent for approval.`);\n\nconst rep = JSON.parse(run.validation_report || '{}');\nconst exp = JSON.parse(run.explainer_json || '{}');\nconst host = u => (String(u).match(/^https?:\\/\\/([^\\/?#]+)/) || [])[1] || u;\nconst srcLines = (rep.sources || []).map(s => `  - ${host(s.url)}: ${s.status === 'verified' ? 'verified' : s.status.toUpperCase()} (${s.facts})`);\nconst flags = [];\nif ((rep.explainer_needs_review || []).length) flags.push('⚠ An official page changed – review the explainer before approving.');\nif ((rep.explainer_unverified || []).length) flags.push('ℹ Some sources could not be fetched this week (marked UNREACHABLE).');\nconst plain = md => String(md).replace(/\\*\\*/g, '').replace(/^#+\\s*/gm, '').replace(/^\\s*\\*(Metric:)\\*/gm, '   $1');\n\nconst message = [\n  `Review Pulse – approval needed for ${run.run_id}`, '',\n  `Validation: ${rep.passed ? 'PASSED' : 'NOT PASSED'} (attempt ${rep.attempt}, ${rep.pulse_words} words; quotes verbatim: ${rep.checks?.quotes_verbatim}; numbers from stats: ${rep.checks?.numbers_from_stats})`,\n  'Official sources:', ...srcLines, ...flags, '',\n  '================ WEEKLY PULSE ================', plain(run.weekly_pulse), '',\n  '================ FEE EXPLAINER (support snippet) ================', ...exp.bullets.map(b => `• ${b}`), '',\n  'Sources:', ...exp.source_links.map(u => `  ${u}`), `Last checked: ${exp.last_checked}`, '',\n  '================ IF YOU APPROVE ================',\n  '1. This entry is appended to \"Weekly Product Pulse Log\" (Google Doc).',\n  `2. A Gmail DRAFT is created to ${cfg.draft_to_email || cfg.approver_email} – it is NOT sent.`,\n  'If you reject, nothing is written anywhere.',\n].join('\\n');\n\nreturn [{ json: {\n  run_id: run.run_id, to: cfg.approver_email,\n  subject: `[Approve?] Weekly Product Pulse ${run.run_id} – ${run.fee_code}`,\n  message, timeout_hours: Number(cfg.approval_timeout_hours || 48),\n}}];\n"
      },
      "id": "2d1fbd00-3775-493a-b9f0-ef1373eaa8af",
      "name": "Prepare approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// ---- Row update for the runs tab (only real columns) ----\nconst p = $('Prepare approval').first().json;\nconst ts = new Date(Date.now() + 5.5 * 3600e3).toISOString().slice(0, 19);\nconst STATUS = 'awaiting_approval';\nif (STATUS === 'awaiting_approval') return [{ json: { run_id: p.run_id, status: STATUS, approval_sent_at: ts, updated_at: ts } }];\n// decision node\nconst r = $input.first().json;\nconst approved = r?.data?.approved ?? r?.approved;\nif (approved === true) return [{ json: { run_id: p.run_id, status: 'approved', approved_at: ts, approver_comment: 'approved via email', updated_at: ts } }];\nconst expired = approved === undefined;\nreturn [{ json: { run_id: p.run_id, status: expired ? 'expired' : 'rejected', approver_comment: expired ? `no response within ${p.timeout_hours}h` : 'rejected via email', updated_at: ts } }];\n"
      },
