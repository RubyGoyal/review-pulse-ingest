      "parameters": {
        "jsCode": "// ---- After the agent ran the MCP tools: confirm both actions really happened (from the Sheet, not the agent's word) ----\nconst p = $('Prepare approval').first().json;\nconst run = $('Read runs (after publish)').all(0, 0).map(i => i.json).find(r => r.run_id === p.run_id) || {};\nconst ok = !!run.doc_url && !!run.gmail_draft_id;\nconst missing = [!run.doc_url && 'Doc entry', !run.gmail_draft_id && 'Gmail draft'].filter(Boolean);\nreturn [{ json: {\n  run_id: p.run_id, status: ok ? 'published' : 'publish_failed',\n  error: ok ? '' : `Missing after MCP calls: ${missing.join(', ')}. Agent said: ${String($('AI agent (MCP client)').first().json.output || '').slice(0, 300)}`,\n  updated_at: new Date(Date.now() + 5.5 * 3600e3).toISOString().slice(0, 19),\n}}];\n"
