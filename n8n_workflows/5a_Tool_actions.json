    {
      "parameters": {
        "jsCode": "// ---- Record what the tool did on the run row, and return a short result to the MCP caller ----\nconst b = $('Build content').first().json;\nconst r = $input.first().json;\nconst ts = new Date(Date.now() + 5.5 * 3600e3).toISOString().slice(0, 19);\nif (b.action === 'append_to_doc') {\n  const docUrl = `https://docs.google.com/document/d/${b.doc_id}/edit`;\n  return [{ json: { run_id: b.run_id, doc_url: docUrl, updated_at: ts } }];\n}\nconst id = r.id || r.draftId || r.message?.id || '';\nif (!id) throw new Error('Gmail did not return a draft id');\nreturn [{ json: { run_id: b.run_id, gmail_draft_id: id, updated_at: ts } }];\n"
      },
