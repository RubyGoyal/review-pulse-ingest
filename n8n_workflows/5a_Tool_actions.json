    {
      "parameters": {
        "jsCode": "// ---- Build the exact Doc entry / email draft for one run, from the Sheet (never from AI text) ----\nconst input = $('When called by MCP tool').first().json;\nconst action = String(input.action || '').trim();\nconst runId = String(input.run_id || '').trim();\nconst cfg = Object.fromEntries($('Read config').all(0, 0).map(i => [i.json.key, String(i.json.value ?? '')]));\nconst fees = Object.fromEntries($('Read fee_types').all(0, 0).map(i => [i.json.fee_code, i.json.label]));\nconst run = $('Read runs').all(0, 0).map(i => i.json).find(r => r.run_id === runId);\n\nif (!['append_to_doc', 'create_email_draft'].includes(action)) throw new Error(`Unknown action \"${action}\"`);\nif (!run) throw new Error(`Run ${runId} not found`);\nif (!['approved', 'published', 'publish_failed'].includes(String(run.status)))\n  throw new Error(`Run ${runId} is \"${run.status}\". Only approved runs can be published.`);\n\nconst exp = JSON.parse(run.explainer_json);\nconst fmt = s => { const d = new Date(String(s).slice(0, 10) + 'T00:00:00Z'); return isNaN(d) ? s : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }); };\nconst today = new Date(Date.now() + 5.5 * 3600e3).toISOString().slice(0, 10);\nconst themes = String(run.top_themes).split(',').filter(Boolean);\nconst payload = {\n  date: today,\n  week: `${run.run_id} (${fmt(run.week_start)} – ${fmt(run.week_end)})`,\n  top_themes: themes,\n  weekly_pulse: run.weekly_pulse,\n  identified_fee_issue: `${run.fee_code}: ${fees[run.fee_code] || ''} (${run.fee_count} reviews in 10 weeks; ${String(run.fee_trend).split(',').pop().trim()})`,\n  explanation_bullets: exp.bullets,\n  source_links: exp.source_links,\n  last_checked: exp.last_checked,\n};\n\n// already done? → idempotent: return existing result, write nothing\nif (action === 'append_to_doc' && run.doc_url) return [{ json: { skip: true, action, run_id: runId, result: run.doc_url } }];\nif (action === 'create_email_draft' && run.gmail_draft_id) return [{ json: { skip: true, action, run_id: runId, result: run.gmail_draft_id } }];\n\nconst strip = md => String(md).replace(/\\*\\*/g, '').replace(/^#+\\s*/gm, '').replace(/^\\s*\\*(Metric:)\\*/gm, '   $1');\nconst docText = [\n  '', '────────────────────────────────────────',\n  `WEEKLY ENTRY · ${run.run_id} · week ending ${fmt(run.week_end)} · logged ${fmt(today)}`,\n  '────────────────────────────────────────',\n  `date: ${payload.date}`,\n  `top_themes: ${themes.join(', ')}`,\n  `identified_fee_issue: ${payload.identified_fee_issue}`, '',\n  'weekly_pulse:', strip(run.weekly_pulse), '',\n  'explanation_bullets:', ...exp.bullets.map(b => `• ${b}`), '',\n  'source_links:', ...exp.source_links.map(u => `- ${u}`),\n  `Last checked: ${fmt(exp.last_checked)}`, '',\n  'payload_json:', JSON.stringify(payload), '',\n].join('\\n');\n\n// minimal markdown → HTML for the email draft\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst inline = s => esc(s).replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>').replace(/\\*(.+?)\\*/g, '<i>$1</i>').replace(/\\[(.+?)\\]\\((https?:\\/\\/[^)]+)\\)/g, '<a href=\"$2\">$1</a>');\nconst mdToHtml = md => { const out = []; let list = null;\n  const close = () => { if (list) { out.push(`</${list}>`); list = null; } };\n  for (const line of String(md).split('\\n')) {\n    let m;\n    if ((m = line.match(/^(#{1,3})\\s+(.*)/))) { close(); out.push(`<h${m[1].length + 1}>${inline(m[2])}</h${m[1].length + 1}>`); }\n    else if ((m = line.match(/^\\d+\\.\\s+(.*)/))) { if (list !== 'ol') { close(); out.push('<ol>'); list = 'ol'; } out.push(`<li>${inline(m[1])}`); }\n    else if ((m = line.match(/^\\s+(\\*Metric:\\*.*)/))) { out.push(`<br>${inline(m[1])}</li>`); }\n    else if ((m = line.match(/^-\\s+(.*)/))) { if (list !== 'ul') { close(); out.push('<ul>'); list = 'ul'; } out.push(`<li>${inline(m[1])}</li>`); }\n    else if (!line.trim()) { close(); }\n    else { close(); out.push(`<p>${inline(line)}</p>`); }\n  }\n  close(); return out.join('\\n'); };\nconst subject = `Weekly Product Pulse + Customer Clarification — ${fmt(run.week_end)}`;\nconst html = `<div style=\"font-family:Arial,sans-serif;font-size:14px;line-height:1.5;color:#222\">\n<p>Hi team,</p><p>Here is this week's product pulse from Google Play reviews, followed by a reusable support snippet for the most common fee confusion.</p>\n${mdToHtml(run.weekly_pulse)}\n<hr><h2>Support snippet: \"I paid ₹399 but the app still shows Free\"</h2>\n<p><i>Reusable as-is in replies to users. Facts only; sources below.</i></p>\n${mdToHtml(exp.markdown)}\n<hr><p style=\"color:#777;font-size:12px\">Drafted by the Review Pulse agent after human approval. Not sent automatically.</p></div>`;\n\nreturn [{ json: { skip: false, action, run_id: runId, doc_id: cfg.pulse_doc_id, doc_text: docText,\n  to: cfg.draft_to_email || cfg.approver_email, subject, html } }];\n"
      },
