    {
      "parameters": {
        "jsCode": "// ---- Text returned to the AI agent over MCP ----\nconst b = $('Build content').first().json;\nlet result = b.skip ? b.result : '';\ntry { const s = $('Save link to runs').first().json; result = s.doc_url || s.gmail_draft_id || result; } catch (e) {}\nconst msg = b.action === 'append_to_doc'\n  ? (b.skip ? `Already appended for ${b.run_id}: ${result}` : `Appended ${b.run_id} to the Doc: ${result}`)\n  : (b.skip ? `Draft already exists for ${b.run_id}: ${result}` : `Created Gmail draft (not sent) for ${b.run_id}: ${result}`);\nreturn [{ json: { response: msg } }];\n"
      },
