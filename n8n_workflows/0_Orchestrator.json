      "parameters": {
        "jsCode": "// ---- Decide what this hourly check should do for last week's run ----\n// Runs Mon 08:00–12:00 IST (hourly) and on manual runs. Safe to run any number of times.\nconst IST = 5.5 * 3600e3;\nconst nowIst = new Date(Date.now() + IST);                       // \"IST clock\" stored in a UTC Date\nconst ts = nowIst.toISOString().slice(0, 19);\nconst hour = nowIst.getUTCHours();\nlet manual = false;\ntry { manual = $('Run manually').isExecuted; } catch (e) {}\nconst FINAL_HOUR = 12;                                           // last scheduled check (12:00 IST)\nconst STALE_MIN = 90;                                            // a 'processing' run older than this is resumed\n\n// last full ISO week (Mon–Sun) in IST\nconst isoWeek = d => {\n  const t = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()));\n  const day = t.getUTCDay() || 7; t.setUTCDate(t.getUTCDate() + 4 - day);\n  const y = t.getUTCFullYear(), w = Math.ceil(((t - Date.UTC(y, 0, 1)) / 864e5 + 1) / 7);\n  return `${y}-W${String(w).padStart(2, '0')}`;\n};\nlet runId = '';\ntry { runId = String($('Week override').first().json.run_id || '').trim(); } catch (e) {}\nif (!/^\\d{4}-W\\d{2}$/.test(runId)) runId = isoWeek(new Date(nowIst.getTime() - 7 * 864e5));\n\n// \"2026-10-14 0:17:42\" or \"2026-10-14T00:17:42\" (IST) -> minutes ago\nconst minutesAgo = s => {\n  const m = String(s || '').match(/(\\d{4})-(\\d{2})-(\\d{2})[ T](\\d{1,2}):(\\d{2})/);\n  if (!m) return Infinity;\n  return (nowIst - Date.UTC(+m[1], +m[2] - 1, +m[3], +m[4], +m[5])) / 6e4;\n};\n\nconst ingest = $('Read ingest_log').all(0, 0).map(i => i.json).find(r => r.run_id === runId);\nconst run = $('Read runs').all(0, 0).map(i => i.json).find(r => r.run_id === runId);\nconst out = (action, reason, extra = {}) => [{ json: { action, reason, run_id: runId, checked_at: ts, ...extra } }];\n\n// 1. Already handled this week? (approval sent, published, rejected…)\nconst DONE = ['awaiting_approval', 'approved', 'published', 'publish_failed', 'rejected', 'expired'];\nif (run && DONE.includes(String(run.status)))\n  return out('skip', `${runId} is already \"${run.status}\" – nothing to do.`);\nif (run && run.status === 'processing' && minutesAgo(run.updated_at) < STALE_MIN)\n  return out('skip', `${runId} is being processed by another execution (started ${run.updated_at}).`);\n\n// 2. Has GitHub finished collecting the reviews?\nconst st = String(ingest?.status || 'not started');\nif (st === 'done')\n  return out('run', `Ingest done${ingest.reviews_new ? ` (${ingest.reviews_new} new reviews)` : \"\"}. Starting analysis.`,\n             { status: 'processing', updated_at: ts, error: '' });\nif (run && run.status === 'blocked')\n  return out('skip', `${runId} was already blocked and you were alerted: ${run.error}. Re-run the GitHub ingest, then run this again.`);\nif (st === 'failed' || st === 'low_volume' || manual || hour >= FINAL_HOUR) {\n  const why = st === 'failed' ? `GitHub ingest failed: ${ingest.error || 'see the Actions log'}`\n    : st === 'low_volume' ? `Too few reviews collected (${ingest.error || 'low volume'})`\n    : `Reviews for ${runId} were not collected by ${manual ? 'now' : FINAL_HOUR + ':00 IST'} (ingest status: ${st}).`;\n  return out('block', why, { status: 'blocked', updated_at: ts, error: why });\n}\nreturn out('skip', `Ingest is \"${st}\" – will check again next hour.`);\n"
      },
