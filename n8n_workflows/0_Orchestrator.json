      "parameters": {
        "jsCode": "// ---- Did Analyse finish? Retry once if tagging is still in progress ----\nconst runId = $('Decide').first().json.run_id;\nconst run = $input.all().map(i => i.json).find(r => r.run_id === runId) || {};\nconst MAX_ATTEMPTS = 3;\nconst attempt = $runIndex + 1;\nconst st = String(run.status || 'missing');\nif (st === 'analysed') return [{ json: { next: 'draft', run_id: runId, attempt } }];\nif (st === 'tagging_in_progress' && attempt < MAX_ATTEMPTS)\n  return [{ json: { next: 'retry', run_id: runId, attempt } }];\nconst why = st === 'analysed_no_fee_issue'\n  ? `${runId}: no fee/charge issue found in the 10-week window, so there is nothing to explain. Check the fee_types tab.`\n  : `${runId}: analysis did not finish (status \"${st}\" after ${attempt} attempt(s)). ${run.error || ''}`;\nreturn [{ json: { next: 'fail', run_id: runId, error: why } }];\n"
      },
