        "jsCode": "// ---- Is the draft ready for approval? ----\nconst runId = $('Decide').first().json.run_id;\nconst run = $input.all().map(i => i.json).find(r => r.run_id === runId) || {};\nif (run.status === 'draft_ready') return [{ json: { ok: true, run_id: runId } }];\nlet failures = '';\ntry { failures = (JSON.parse(run.validation_report || '{}').failures || []).join('; '); } catch (e) {}\nreturn [{ json: { ok: false, run_id: runId,\n  error: `${runId}: draft not ready (status \"${run.status || 'missing'}\"). ${failures || run.error || ''}`.trim() } }];\n"
